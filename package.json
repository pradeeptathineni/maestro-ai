{
  "name": "maestro-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "scripts": {
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p tsconfig.build.json",
    "benchmark:phase06": "node --import tsx scripts/benchmark-phase06.ts",
    "bundle:verify": "node --import tsx scripts/verify-bundle.ts",
    "clean": "node scripts/clean.mjs",
    "context:pack": "node scripts/run-context-pack.mjs",
    "context:pack:test": "node --test scripts/run-context-pack.test.mjs",
    "context:verify": "node scripts/verify-context-engineering.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/seed/src/import.ts",
    "db:schema-check": "node --env-file-if-exists=.env --import tsx packages/db/src/schema-check.ts",
    "db:init": "npm run db:migrate && npm run worker:init && npm run db:seed",
    "dev": "concurrently --kill-others --names api,worker,web --prefix-colors cyan,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:setup": "npm run db:init && npm run dev",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch apps/worker/src/server.ts",
    "eval:phase06": "node --import tsx scripts/evaluate-phase06.ts",
    "eval:phase07": "node --import tsx scripts/evaluate-phase07.ts",
    "study:discovery-live": "node --import tsx scripts/run-discovery-live-study.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "quality:dead-code": "knip --no-progress",
    "quality:duplicates": "jscpd --config .jscpd.json",
    "quality:structure": "npm run quality:dead-code && npm run quality:duplicates",
    "security:dependencies": "node scripts/dependency-check.mjs",
    "security:audit": "node scripts/dependency-audit-policy.mjs",
    "security:audit:test": "node --test scripts/dependency-audit-policy.test.mjs",
    "security:secrets": "node scripts/secret-check.mjs",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "start:test-stack": "concurrently --kill-others --names api,worker --prefix-colors cyan,magenta \"npm:start\" \"npm:start:worker\"",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/src/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node --import tsx packages/test-fixtures/src/prepare-e2e.ts && playwright test",
    "test:provenance": "node --import tsx packages/seed/src/audit.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker:init": "node --env-file-if-exists=.env --import tsx apps/worker/src/initialize.ts",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.59",
    "@antv/g6": "5.1.1",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@mozilla/readability": "0.6.0",
    "@opentelemetry/api": "1.9.1",
    "@tanstack/react-query": "5.103.2",
    "ai": "7.0.122",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "graphile-worker": "0.18.0",
    "jsdom": "30.1.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typebox": "1.3.34",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@linger-alpha/cca": "0.2.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "jscpd": "5.3.3",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "repomix": "1.18.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
